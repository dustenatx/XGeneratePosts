{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git rebase *)",
      "Bash(git pull --rebase*)",
      "Bash(git pull * --rebase*)",
      "Bash(git tag *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Edit(/tests/acceptance/**)",
      "Edit(/.claude/settings.json)",
      "Read(~/.ai_post_env)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(*.ai_post_env*)"
    ]
  }
}
